{
  "name": "openrouter-monitor",
  "version": "1.0.0",
  "description": "Monitor OpenRouter for new models via RSS feed",
  "type": "module",
  "scripts": {
    "start": "bun run src/monitor.ts",
    "dev": "bun --watch run src/monitor.ts",
    "build": "bun build src/monitor.ts --outdir=dist --target=bun"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0"
  }
}
